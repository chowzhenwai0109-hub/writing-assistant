# Local/demo mode: no Gemini requests, even when a key is present.
LLM_PROVIDER=gemini
LLM_MODE=fake
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

# Optional backend/.env overrides root .env; process env overrides both.
# Alternative: LLM_MODEL=gemini-3.6-flash
# For user-triggered Gemini requests set LLM_MODE=live, then restart.
# Start Writing Assistant.bat offers demo and both live models per launch.
# Setup/startup/health never call Gemini. Verification stays offline.
